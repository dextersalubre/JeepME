<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/jeepme_green">

    <!-- Map placeholder (gray box) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#2C3E50"/>

    <!-- Route Info Card -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/white"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvRouteName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12G Labangon - SM"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvFare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fare: 13-20"
                android:textSize="14sp"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Discount of 20% for Student/PWD/Elderly"
                android:textSize="12sp"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Route:"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_dark"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvStops"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Route stops here..."
                android:textSize="13sp"
                android:textColor="@color/text_dark"
                android:lineSpacingMultiplier="1.4"/>

        </LinearLayout>
    </ScrollView>

    <!-- Back Button -->
    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back"
        android:textStyle="bold"
        android:backgroundTint="@color/route_badge"
        android:textColor="@color/white"
        android:layout_margin="16dp"/>

</LinearLayout>