<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="edu.cit.jeepme">

    <application
        android:name=".JeepMeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="JeepMe"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JeepMe">

        <activity android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="auth.OptionActivity" />
        <activity android:name="auth.LoginActivity" />
        <activity android:name="auth.SignUpActivity" />
        <activity android:name="home.HomeActivity" />
        <activity android:name="routes.RouteDetailActivity" />
        <activity android:name="profile.ProfileEditActivity" />
        <activity android:name="profile.PrivacyPolicyActivity" />

    </application>
</manifest>